# Environment (development, production, test)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Vector Database (Qdrant)
# For local docker-compose: http://qdrant:6333
# For Qdrant Cloud: https://xxxx-xxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME=technical_documents
REDIS_URL=redis://redis:6379/0

# LLM Configuration (Unified key across providers)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_PROVIDER_API_KEY=your_gemini_or_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=768
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_HISTORY_CHARS=2400
LLM_MAX_OUTPUT_TOKENS=512
LLM_THINKING_BUDGET=0
OCR_DPI=120
RESOURCE_PROFILE=free
MAX_UPLOAD_SIZE_MB=10
EMBEDDING_BATCH_SIZE=10
QDRANT_UPSERT_BATCH_SIZE=10
BM25_MAX_CHUNKS_IN_MEMORY=2000
RECOVER_INTERRUPTED_JOBS=true

# Local Storage for Extracted Documents & Images
STORAGE_PATH=./storage
CORS_ORIGINS=["http://localhost:3000", "https://*.vercel.app"]
