# ==============================================================================
# MULTIMODAL RAG - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environment (development, production, test)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. VECTOR DATABASE (Qdrant)
# ------------------------------------------------------------------------------
# For local Docker Compose: http://localhost:6333
# For Qdrant Cloud: https://<your-cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME=technical_documents
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 2. LLM & EMBEDDINGS (Pluggable: gemini / openai)
# ------------------------------------------------------------------------------
# Set LLM_PROVIDER to "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_PROVIDER_API_KEY=your_gemini_or_openai_api_key_here

# For Gemini (Recommended & Stable: gemini-embedding-001, 768 dims):
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_HISTORY_CHARS=2400
LLM_MAX_OUTPUT_TOKENS=512
LLM_THINKING_BUDGET=0
OCR_DPI=120
MAX_UPLOAD_SIZE_MB=50
EMBEDDING_BATCH_SIZE=50
QDRANT_UPSERT_BATCH_SIZE=25
BM25_MAX_CHUNKS_IN_MEMORY=5000
RECOVER_INTERRUPTED_JOBS=true

# For OpenAI (if switching back):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# For Local 100% Offline execution with Ollama & EmbeddingGemma (768 dims):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434          # or http://host.docker.internal:11434 in Docker
# LLM_MODEL=gemma2:2b                         # or llama3.2 / mistral
# EMBEDDING_MODEL=embeddinggemma              # or nomic-embed-text
# EMBEDDING_DIMENSION=768                     # EmbeddingGemma natively outputs 768 dims

# ------------------------------------------------------------------------------
# 3. LOCAL STORAGE & NETWORK
# ------------------------------------------------------------------------------
STORAGE_PATH=./storage
CORS_ORIGINS=["http://localhost:3000", "https://*.vercel.app"]

# ------------------------------------------------------------------------------
# 4. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
